NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai_intern_system

# JWT
JWT_SECRET=replace_with_at_least_64_random_chars_in_production
JWT_EXPIRES_IN=7d

# Google Gemini API (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# SMTP Email Settings (Gmail example — use App Password, not your main password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM_NAME=AI Intern Coordinator
EMAIL_FROM_ADDRESS=your_email@gmail.com

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# Google Calendar / OAuth 2.0 (optional — leave blank to skip)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=

# GitHub API (optional — for repo link validation)
GITHUB_TOKEN=

# Dev Mock Modes — set true to avoid real API calls in development
# MOCK_EMAIL=true  → logs emails to console instead of sending
# MOCK_GEMINI=false → uses real Gemini API (set false if you have a key)
MOCK_EMAIL=true
MOCK_CALENDAR=true
MOCK_GEMINI=false

# Scheduler timing
REMINDER_HOURS_BEFORE=24
FIRST_REVIEW_DELAY_DAYS=3
NEXT_REVIEW_DELAY_DAYS=3

# File upload limits
MAX_FILE_SIZE_MB=10
